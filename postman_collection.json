          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+91 9876543298\",\n  \"address\": {\n    \"street\": \"25 Church Street Apt 4B\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"560001\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/cadets/me/update", "host": ["{{baseUrl}}"], "path": ["cadets", "me", "update"] }
