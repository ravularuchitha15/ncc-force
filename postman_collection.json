          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/cadets?search=&unit=1 Karnataka&status=Active&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["cadets"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "unit", "value": "1 Karnataka" },
                { "key": "status", "value": "Active" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
