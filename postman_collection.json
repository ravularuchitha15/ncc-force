          }
        },
        {
          "name": "Deactivate Cadet",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/cadets/:id", "host": ["{{baseUrl}}"], "path": ["cadets", ":id"] }
